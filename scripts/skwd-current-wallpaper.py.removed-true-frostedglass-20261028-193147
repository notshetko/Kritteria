#!/usr/bin/env python3
"""Print the current local image file used by skwd-wall, or '-' if unavailable."""
from pathlib import Path
SUPPORTED = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif", ".avif"}
PRIORITY = {
    "skwd-wall-still": 0,
    "skwd-wall-vk": 1,
    "skwd-wall-video": 2,
    "skwd-wall-image": 3,
}

candidates = []
proc = Path("/proc")
try:
    entries = list(proc.iterdir())
except OSError:
    entries = []

for entry in entries:
    if not entry.name.isdigit():
        continue
    try:
        raw = (entry / "cmdline").read_bytes().split(b"\0")
        argv = [part.decode("utf-8", "surrogateescape") for part in raw if part]
    except (OSError, PermissionError):
        continue
    if not argv:
        continue
    exe = Path(argv[0]).name
    matched = next((name for name in PRIORITY if exe == name or exe.startswith(name + "-")), None)
    if matched is None:
        continue
    for arg in argv[1:]:
        if not arg.startswith("/"):
            continue
        candidate = Path(arg)
        if candidate.suffix.lower() not in SUPPORTED or not candidate.is_file():
            continue
        try:
            stat = entry.stat()
            # Prefer a still wallpaper renderer, then a local path used by a video renderer.
            candidates.append((PRIORITY[matched], -stat.st_ctime, str(candidate)))
        except OSError:
            candidates.append((PRIORITY[matched], 0, str(candidate)))
        break

if candidates:
    candidates.sort()
    print(candidates[0][2])
else:
    print("-")
